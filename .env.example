# Root project environment example

APP_NAME=SportFieldHub
APP_ENV=local

# Internal service communication
INTERNAL_SERVICE_TOKEN=change_this_internal_service_token

# JWT
JWT_SECRET=change_this_jwt_secret_key_minimum_32_chars

# Gateway
GATEWAY_PORT=8000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Auth Service
AUTH_SERVICE_PORT=8001
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=3306
AUTH_DB_DATABASE=auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Field Service
FIELD_SERVICE_PORT=8002
FIELD_DB_HOST=field-db
FIELD_DB_PORT=3306
FIELD_DB_DATABASE=field_db
FIELD_DB_USERNAME=field_user
FIELD_DB_PASSWORD=field_password

# Booking Service
BOOKING_SERVICE_PORT=8003
BOOKING_DB_HOST=booking-db
BOOKING_DB_PORT=3306
BOOKING_DB_DATABASE=booking_db
BOOKING_DB_USERNAME=booking_user
BOOKING_DB_PASSWORD=booking_password